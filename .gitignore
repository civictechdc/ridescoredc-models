# Local yoyo config — copy live/yoyo.ini.example to live/yoyo.ini and customize.
# Kept out of git so local/manual settings (e.g. batch_mode, a database line)
# never get committed.
live/yoyo.ini
__pycache__/

# Python / uv
.venv/
*.egg-info/
.pytest_cache/
.ruff_cache/

# Pipeline working directories -- dated source snapshots and build artifacts.
# Never committed: the cache is per-machine, and outputs belong in a package.
# Matched without a trailing slash so that a *symlink* named raw or out --
# how a scratch checkout points at an existing snapshot -- is ignored too.
# `raw/` matches only a directory, which is how both got committed once.
/raw
/out

docs-for-ai/