# Secret NAMES only. Never commit values — this file is a checklist, not config.
#
# On the Kestra host these live in ~/Projects/kestra-ridescore/.env, are encoded
# into .env_encoded as base64 SECRET_* lines, and are loaded by the kestra
# service via env_file. The encoding recipe is in kestra/README.md.
#
# In a flow, read one with:   {{ secret('PG_HOST') }}

# --- warehouse, used by prod.ridescore.load_database -------------------------
PG_HOST=
PG_PORT=
PG_DATABASE=
PG_USER=
PG_PASSWORD=

# --- git sync, used by prod.sync.sync_git_flows ------------------------------
# The key that appears in the webhook URL path. This is NOT the UI login; the
# webhook authenticates on the path key alone, so treat it as a password and
# rotate it if it ever appears in a log, a screenshot, or a chat message.
WEBHOOK_KEY=
